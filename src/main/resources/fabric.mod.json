{
	"schemaVersion": 1,
	"id": "spotify-client",
	"version": "${version}",
	"icon": "assets/spotify-client/logo.png",
	"name": "Spotify Client",
	"description": "Spotify in Minecraft: now-playing widget, playback keys, and a full client to search, play and manage your library and playlists.",
	"authors": [
		"ronflement"
	],
	"contact": {
		"homepage": "https://github.com/Ronflement/spotify-client",
		"sources": "https://github.com/Ronflement/spotify-client",
		"issues": "https://github.com/Ronflement/spotify-client/issues"
	},
	"license": "PolyForm-Strict-1.0.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.spotifyclient.SpotifyClientMod"
		],
		"modmenu": [
			"com.spotifyclient.config.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}